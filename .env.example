DATABASE_URL=postgres://localhost:5432/fairdrop
# docker-compose: postgres://fairdrop:fairdrop@localhost:5432/fairdrop
SESSION_SECRET=change-me-32-bytes-min
DRAW_KEY=change-me-32-bytes-min
ADMIN_TOKEN=change-me
SIM_MODE=false            # true only for load tests; enables /api/sim/* and X-Sim-Client-IP
SIM_SECRET=change-me
DEV_LOGIN=false           # true enables /api/auth/dev-login (stand-in for email OTP)
PG_POOL_MAX=20
MAX_DB_QUEUE=500          # shed load with 503 when this many queries wait for a connection
# Phone verification (drops with config.requirePhone). Without Twilio, DEV_LOGIN=true returns the code in the API response.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PHONE_BLOCK_VIRTUAL=false # true rejects VoIP/virtual numbers via Twilio Lookup
